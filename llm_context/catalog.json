  "vetted_sql": [
    {
      "question": "How many visits did each clinic have last month?",
      "sql": "select c.clinic_name, count(*) as visits from marts.fct_appointment a join marts.dim_clinic c using (clinic_id) where a.is_visit and a.local_date >= date_trunc('month', current_date) - interval '1 month' and a.local_date < date_trunc('month', current_date) group by 1 order by 2 desc"
    },
    {
      "question": "Which plan tier pays out the most care relative to dues?",
      "sql": "select plan_code, sum(covered_care_value) / nullif(sum(dues_collected), 0) as care_to_dues_ratio from metrics.metric_plan_economics_monthly group by 1 order by 2 desc"
    },
    {
      "question": "What is the no-show rate by clinic over the last 3 months?",
      "sql": "select clinic_name, sum(appointments * no_show_rate) / sum(appointments) as no_show_rate from metrics.metric_clinic_monthly where month_start >= date_trunc('month', current_date) - interval '3 month' group by 1 order by 2 desc"
    },
    {
      "question": "Which high-severity data issues need attention?",
      "sql": "select issue_type, clinic_name, count(*) from reports.rpt_reconciliation_issues where severity = 'high' group by 1, 2 order by 3 desc"
    }
  ]
